<Window x:Class="TimesheetBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timesheet Buddy 3.0"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}"
        AllowsTransparency="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TaskCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TaskCellMuted" TargetType="TextBlock" BasedOn="{StaticResource TaskCellText}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="TaskCellNumber" TargetType="TextBlock" BasedOn="{StaticResource TaskCellText}">
            <Setter Property="Foreground" Value="{StaticResource TimerBrush}"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="TaskHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
        <DockPanel Margin="8">
            <!-- Title bar -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" FontSize="13" Text="Timesheet Buddy 3.0"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="PinToggle" Margin="8,0,0,0" Padding="8,2"
                                  Content="📌 Pin" ToolTip="Keep window always on top"
                                  Checked="PinToggle_Changed" Unchecked="PinToggle_Changed"
                                  Background="{StaticResource AccentSoftBrush}"
                                  BorderBrush="{StaticResource LineBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="AppMenuButton" Style="{StaticResource GhostButton}" Content="Menu"
                            ToolTip="Weeks, export, and job code view" Click="Menu_Click" FontSize="12" Padding="6,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="+" ToolTip="Add manual entry"
                            Click="AddManual_Click" FontSize="16" FontWeight="SemiBold" Padding="8,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="⚙" ToolTip="Settings"
                            Click="Settings_Click" FontSize="14" Padding="6,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="⏱" ToolTip="Today's log"
                            Click="DayLog_Click" FontSize="14" Padding="6,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="—" ToolTip="Minimize"
                            Click="Minimize_Click" FontSize="14" Padding="6,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="✕" ToolTip="Close"
                            Click="Close_Click" FontSize="12" Padding="6,0"/>
                </StackPanel>
            </Grid>

            <!-- Timer -->
            <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                <TextBlock x:Name="TimerText"
                           FontFamily="Consolas, Cascadia Mono, Courier New"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TimerBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="00:00:00"/>
            </Border>

            <!-- Controls -->
            <Grid DockPanel.Dock="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Job code" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                    <ComboBox x:Name="JobCodeCombo" DisplayMemberPath="Display"
                              SelectionChanged="JobCodeCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Category" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CategoryCombo" IsEditable="True"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                    <TextBlock Text="Task name" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TaskNameCombo" IsEditable="True"
                                  KeyDown="TaskNameCombo_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Content="Start" Margin="6,0,0,0" Padding="12,4"
                                Click="Start_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource CompactButton}"
                                Content="Stop" Margin="4,0,0,0" Padding="10,4"
                                Click="Stop_Click"/>
                    </Grid>
                </StackPanel>

                <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource CompactButton}"
                            Content="+ Quick add" Click="QuickAdd_Click" Padding="10,3"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Text="Idle — pick a job code or task to start"/>
                </DockPanel>
            </Grid>

            <!-- Today, one row per task type -->
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Margin="0,0,0,4" Text="Today by task — click a row to keep going"/>
                <Grid x:Name="TaskHeader" DockPanel.Dock="Top" Margin="9,0,9,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource TaskHeaderText}" Text="Task"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource TaskHeaderText}" Text="Category"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource TaskHeaderText}" Text="Job code"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource TaskHeaderText}" Text="Total"
                               HorizontalAlignment="Right" Margin="0"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource TaskHeaderText}" Text="#"
                               HorizontalAlignment="Right" Margin="0"
                               ToolTip="Number of segments that make up the total"/>
                </Grid>
                <Grid>
                    <ScrollViewer x:Name="TaskScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="TaskScroll_ScrollChanged">
                        <ItemsControl x:Name="TaskRowsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,3" CornerRadius="4" Padding="8,4" Cursor="Hand"
                                            MouseLeftButtonDown="TaskRow_MouseLeftButtonDown"
                                            MouseLeftButtonUp="TaskRow_MouseLeftButtonUp">
                                        <Border.ToolTip>
                                            <TextBlock>
                                                <Run Text="{Binding TaskName, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding Category, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding JobCodeDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border.ToolTip>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource TaskCellText}" FontWeight="SemiBold"
                                                       Text="{Binding TaskName}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource TaskCellMuted}"
                                                       Text="{Binding Category}"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource TaskCellMuted}"
                                                       Text="{Binding JobCodeDisplay}"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource TaskCellNumber}"
                                                       FontWeight="SemiBold" Text="{Binding TotalText}"/>
                                            <TextBlock Grid.Column="4" Style="{StaticResource TaskCellNumber}"
                                                       Text="{Binding SegmentCount}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="TaskEmptyText" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Text="Nothing logged today yet" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
