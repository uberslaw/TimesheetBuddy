<Window x:Class="TimesheetBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timesheet Buddy 3.0"
        Icon="/Assets/TimesheetBuddy.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}"
        AllowsTransparency="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TaskCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TaskCellMuted" TargetType="TextBlock" BasedOn="{StaticResource TaskCellText}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="TaskCellNumber" TargetType="TextBlock" BasedOn="{StaticResource TaskCellText}">
            <Setter Property="Foreground" Value="{StaticResource TimerBrush}"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="TaskHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
        <DockPanel Margin="8">
            <!-- Title bar -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" FontSize="13" Text="Timesheet Buddy 3.0"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="PinToggle" Margin="8,0,0,0" Padding="8,2"
                                  Content="📌 Pin" ToolTip="Keep window always on top"
                                  Checked="PinToggle_Changed" Unchecked="PinToggle_Changed"
                                  Background="{StaticResource AccentSoftBrush}"
                                  BorderBrush="{StaticResource LineBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="AppMenuButton" Style="{StaticResource GhostButton}" Content="Menu"
                            ToolTip="Day log, weeks and export, job code view, settings and more" Click="Menu_Click" FontSize="12" Padding="6,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="—" ToolTip="Minimize"
                            Click="Minimize_Click" FontSize="14" Padding="6,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="✕" ToolTip="Close"
                            Click="Close_Click" FontSize="12" Padding="6,0"/>
                </StackPanel>
            </Grid>

            <!-- History mode banner -->
            <Border x:Name="HistoryBanner" DockPanel.Dock="Top"
                    Background="#FEF3C7" CornerRadius="4" Padding="8,5" Margin="0,0,0,6"
                    Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CompactButton}"
                            Content="Back to today" Padding="8,2" Click="BackToToday_Click"/>
                    <TextBlock x:Name="HistoryBannerText" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="11"
                               Text="Editing older timesheet — timer inactive"/>
                </DockPanel>
            </Border>

            <!-- Timer + today's totals by job code -->
            <Border x:Name="TimerPanel" DockPanel.Dock="Top" Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="DayTotalsPanel" VerticalAlignment="Center"
                                Grid.IsSharedSizeScope="True"
                                    ToolTip="Time accounted for today by job code (most to least), with each code's share of Total. Remaining is 7.5h minus logged.">
                        <TextBlock x:Name="DayCodeEmptyText"
                                   FontSize="11"
                                   Margin="6,0,0,0"
                                   Foreground="{StaticResource TimerBrush}"
                                   Text="No time logged"
                                   Visibility="Collapsed"/>
                        <ItemsControl x:Name="DayCodeTotalsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="DayCodeTime"/>
                                            <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="DayCodePercent"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   Margin="6,0,12,0"
                                                   Foreground="{StaticResource TimerBrush}"
                                                   HorizontalAlignment="Left"
                                                   TextAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TimeText}"
                                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TimerBrush}"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PercentText}"
                                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                                   FontSize="11"
                                                   Margin="8,0,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid x:Name="NoTaskRow" Margin="0,0,0,1" Visibility="Collapsed"
                              ToolTip="Time with no task running since you pressed Stop. Not counted in Total until assigned; the next interval check asks where it goes.">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="DayCodeTime"/>
                                <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="DayCodePercent"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="No Task Selected"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Margin="6,0,12,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="NoTaskTotalText"
                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="0"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="DayCodeTime"/>
                                <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="DayCodePercent"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Margin="6,0,12,0"
                                       Foreground="{StaticResource TimerBrush}"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="DayGrandTotalText"
                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TimerBrush}"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="0"/>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="DayCodeTime"/>
                                <ColumnDefinition Width="Auto" MinWidth="34" SharedSizeGroup="DayCodePercent"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time Remaining:"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Margin="6,0,12,0"
                                       Foreground="{StaticResource TimerBrush}"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="DayRemainingText"
                                       FontFamily="Consolas, Cascadia Mono, Courier New"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TimerBrush}"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="7:30:00"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TimerText"
                               FontFamily="Consolas, Cascadia Mono, Courier New"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ActiveTimerBrush}"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               MinWidth="96"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               Text="0"/>
                </Grid>
            </Border>

            <!-- Controls -->
            <Grid DockPanel.Dock="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Job code" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                    <ComboBox x:Name="JobCodeCombo" DisplayMemberPath="Display"
                              IsEditable="True"
                              ToolTip="Choose a job code, then press Add to begin tracking"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Category" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CategoryCombo" IsEditable="True"
                              LostFocus="EditorFields_Changed"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Task name" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                        <TextBlock Grid.Column="1" Text="Ticket" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="6,0,0,2"/>
                        <ComboBox x:Name="TaskNameCombo" Grid.Row="1" IsEditable="True"
                                  KeyDown="TaskNameCombo_KeyDown"
                                  LostFocus="EditorFields_Changed"/>
                        <TextBox x:Name="TicketBox" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0"
                                 VerticalContentAlignment="Center" MinHeight="26" Padding="6,3"
                                 CharacterCasing="Upper" MaxLength="40"
                                 ToolTip="Ticket number, e.g. INC0012345 or RITM0012345. RITM / INC sets the job code to 03 — SERVICE-NOW and the category to Support."
                                 TextChanged="TicketBox_TextChanged"
                                 KeyDown="TicketBox_KeyDown"/>
                        <Button x:Name="AddButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                Content="Add" Margin="6,0,0,0" Padding="12,4"
                                ToolTip="Add a task with the job code, category, task name and ticket above, and start its timer"
                                Click="Add_Click"/>
                        <Button x:Name="StopButton" Grid.Row="1" Grid.Column="3" Style="{StaticResource CompactButton}"
                                Content="Stop" Margin="4,0,0,0" Padding="10,4"
                                Click="Stop_Click"/>
                    </Grid>
                    <TextBlock x:Name="TicketHint" Foreground="{StaticResource MutedBrush}" FontSize="10"
                               Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="No 03 / ServiceNow job code found — pick a job code before Add."/>
                </StackPanel>

                <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource CompactButton}"
                            Content="+ Quick add" Click="QuickAdd_Click" Padding="10,3"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Text="Idle — pick a job code or task, then Add"/>
                </DockPanel>
            </Grid>

            <!-- Viewing day, one row per task type -->
            <DockPanel Margin="0,8,0,0">
                <TextBlock x:Name="TasksHeader" DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Margin="0,0,0,4" Text="Today by task — click a row to keep going"/>
                <Grid x:Name="TaskHeader" DockPanel.Dock="Top" Margin="9,0,9,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource TaskHeaderText}" Text=""/>
                    <TextBlock Grid.Column="1" Style="{StaticResource TaskHeaderText}" Text="Task"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource TaskHeaderText}" Text="Category"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource TaskHeaderText}" Text="Job code"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource TaskHeaderText}" Text="Total"
                               HorizontalAlignment="Right" Margin="0"/>
                    <TextBlock Grid.Column="5" Style="{StaticResource TaskHeaderText}" Text="#"
                               HorizontalAlignment="Right" Margin="0"
                               ToolTip="Number of segments that make up the total"/>
                </Grid>
                <Grid>
                    <ScrollViewer x:Name="TaskScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="TaskScroll_ScrollChanged">
                        <StackPanel>
                        <ItemsControl x:Name="TaskRowsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Margin="0,0,0,3" CornerRadius="4" Padding="8,4" Cursor="Hand"
                                                MouseLeftButtonDown="TaskRow_MouseLeftButtonDown"
                                                MouseLeftButtonUp="TaskRow_MouseLeftButtonUp"
                                                ContextMenuOpening="TaskRow_ContextMenuOpening">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Modify Time…" Click="ModifyTimeMenu_Click"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Move Time…" Click="MoveTimeMenu_Click"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem x:Name="StartOrContinueItem"
                                                              Header="Start timer"
                                                              Click="StartTaskMenu_Click"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Change job code…"
                                                              Click="ChangeJobCodeMenu_Click"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Assign time and Delete…"
                                                              Click="AssignAndDeleteMenu_Click"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Delete task" Click="DeleteTaskMenu_Click"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding TaskDisplay, Mode=OneWay}"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding Category, Mode=OneWay}"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding JobCodeDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="{Binding ArrowGlyph}"
                                                        Style="{StaticResource GhostButton}"
                                                        FontSize="10" Padding="2,0"
                                                        Click="ExpandToggle_Click"
                                                        Tag="{Binding}"
                                                        ToolTip="Show segments for this task on the loaded day"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource TaskCellText}" FontWeight="SemiBold"
                                                           Text="{Binding TaskDisplay}"/>
                                                <TextBlock Grid.Column="2" Style="{StaticResource TaskCellMuted}"
                                                           Text="{Binding Category}"/>
                                                <TextBlock Grid.Column="3" Style="{StaticResource TaskCellMuted}"
                                                           Text="{Binding JobCodeDisplay}"/>
                                                <TextBlock Grid.Column="4" Style="{StaticResource TaskCellNumber}"
                                                           FontWeight="SemiBold" Text="{Binding TotalText}"/>
                                                <TextBlock Grid.Column="5" Style="{StaticResource TaskCellNumber}"
                                                           Text="{Binding SegmentCount}"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Children}"
                                                      Visibility="{Binding ChildrenVisibility}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="30,0,8,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="54"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TimeOfDay}"
                                                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DurationDisplay}"
                                                                   FontFamily="Consolas, Cascadia Mono, Courier New"
                                                                   FontSize="11" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="NoTaskListRow" Margin="0,0,0,3" CornerRadius="4" Padding="8,4"
                                Background="Transparent" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Visibility="Collapsed"
                                ContextMenuOpening="NoTaskListRow_ContextMenuOpening"
                                ToolTip="Time with no task running since you pressed Stop. Not counted in Total. Right-click to move it to a task or discard it.">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Move Time…" Click="NoTaskMoveMenu_Click"
                                              ToolTip="Log this time on a task or job code at its original clock times"/>
                                    <MenuItem x:Name="NoTaskSplitItem" Header="Split across tasks…" Click="NoTaskSplitMenu_Click"
                                              ToolTip="Open the No Task Selected assignment dialog now"/>
                                    <Separator/>
                                    <MenuItem Header="Discard time…" Click="NoTaskDiscardMenu_Click"
                                              ToolTip="Remove some or all of this time without logging it anywhere"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="No Task Selected" FontStyle="Italic"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="—" FontStyle="Italic" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="unassigned" FontStyle="Italic" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" x:Name="NoTaskListTotalText" FontStyle="Italic"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Text="0"/>
                                <TextBlock Grid.Column="5" x:Name="NoTaskListSpansText" FontStyle="Italic"
                                           FontFamily="Consolas, Cascadia Mono, Courier New"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Text="0"/>
                            </Grid>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="TaskEmptyText" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Text="Nothing logged today yet" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
