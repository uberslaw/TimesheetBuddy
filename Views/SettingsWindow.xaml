<Window x:Class="TimesheetBuddy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Timesheet Buddy 3.0"
        Icon="/Assets/TimesheetBuddy.ico"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Text="Settings are saved to your data folder (see the Data tab)."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CompactButton}" Content="Cancel" Width="90" Margin="0,0,8,0"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Save" Width="90"
                        IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Tabs">
            <TabItem Header="Job codes">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource CompactButton}" Content="Add row" Click="AddJobCode_Click"/>
                        <Button Style="{StaticResource CompactButton}" Content="Remove selected" Margin="8,0,0,0"
                                Click="RemoveJobCode_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="JobCodesGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource LineBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="FavoritesTab" Header="Favorite tasks">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource CompactButton}" Content="Add favorite" Click="AddFavorite_Click"/>
                        <Button Style="{StaticResource CompactButton}" Content="Remove selected" Margin="8,0,0,0"
                                Click="RemoveFavorite_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="FavoritesGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource LineBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Task name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                            <DataGridComboBoxColumn x:Name="FavoriteJobCodeColumn"
                                                    Header="Job code"
                                                    SelectedValueBinding="{Binding JobCodeId, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectedValuePath="Id"
                                                    DisplayMemberPath="Display"
                                                    Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Categories">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{StaticResource MutedBrush}"
                               Text="One category per line. Used when starting tasks and filtering favorites."/>
                    <TextBox x:Name="CategoriesBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Mono"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Prompts &amp; pin">
                <StackPanel Margin="10">
                    <CheckBox x:Name="AlwaysOnTopCheck" Content="Pin window always on top" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AskBeforeExitCheck" Content="Ask before exiting" Margin="0,0,0,12"
                              ToolTip="Confirm before the ✕ button, Alt+F4 or the taskbar closes Timesheet Buddy. Windows shutdown never asks."/>

                    <TextBlock FontWeight="SemiBold" Text="Still-working recheck" Margin="0,0,0,6"/>
                    <CheckBox x:Name="RecheckEnabledCheck" Content="Ask me if I'm still on the active task" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Default interval:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="RecheckHours" Width="70"/>
                        <TextBlock Text="hours" VerticalAlignment="Center" Margin="6,0,12,0"/>
                        <ComboBox x:Name="RecheckMinutes" Width="70"/>
                        <TextBlock Text="minutes" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <TextBlock FontWeight="SemiBold" Text="15-minute catch-up" Margin="0,0,0,6"/>
                    <CheckBox x:Name="FifteenEnabledCheck"
                              Content="Show “What have you done for the last X minutes?” popup"
                              Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Interval:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="FifteenMinutes" Width="80"/>
                        <TextBlock Text="minutes (popup stays until you respond)"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <TextBlock FontWeight="SemiBold" Text="App Track" Margin="0,16,0,6"/>
                    <CheckBox x:Name="AppTrackCheck" Content="Log time per program I use (App Track)" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="Records only the program name, never window titles, web pages, documents or email. Pauses after 5 minutes without input and while the screen is locked. See Menu → App usage…."/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="WidgetTab" Header="Widget">
                <StackPanel Margin="10">
                    <TextBlock FontWeight="SemiBold" Text="Show when minimized" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}"
                               Text="A small always-on-top timer with Start, Stop and corner-dock arrows while the main window is minimized or hidden."/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="WidgetEnableRadio" GroupName="WidgetShow" Content="Enable"
                                     Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                        <RadioButton x:Name="WidgetDisableRadio" GroupName="WidgetShow" Content="Disable"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0"
                                IsEnabled="{Binding IsChecked, ElementName=WidgetEnableRadio, FallbackValue=False}">
                        <CheckBox x:Name="WidgetCoveredCheck" Margin="0,0,0,6"
                                  Content="Also when the main window is covered by other windows"
                                  ToolTip="Unpinned and at least half hidden behind other apps for about 2 seconds"/>
                        <CheckBox x:Name="WidgetOtherMonitorCheck"
                                  Content="Also when the main window is on another monitor"
                                  ToolTip="The main window's centre is off the primary monitor for about 2 seconds"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="DataTab" Header="Data">
                <StackPanel Margin="10">
                    <TextBlock FontWeight="SemiBold" Text="Data folder" Margin="0,0,0,6"/>
                    <TextBox x:Name="DataFolderBox" IsReadOnly="True" Padding="6,3"
                             VerticalContentAlignment="Center" MinHeight="26"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource CompactButton}" Content="Browse…" Padding="12,3"
                                ToolTip="Choose another folder; your data is moved there as soon as you confirm"
                                Click="BrowseDataFolder_Click"/>
                        <Button Style="{StaticResource CompactButton}" Content="Open folder" Padding="12,3"
                                Margin="8,0,0,0" ToolTip="Show this folder in File Explorer"
                                Click="OpenDataFolder_Click"/>
                        <Button x:Name="UseDefaultFolderButton" Style="{StaticResource CompactButton}"
                                Content="Use default" Padding="12,3" Margin="8,0,0,0"
                                Click="UseDefaultFolder_Click"/>
                        <Button Style="{StaticResource CompactButton}" Content="Import data…" Padding="12,3"
                                Margin="8,0,0,0" ToolTip="Bring entries in from a backup, another folder or an earlier release"
                                Click="ImportData_Click"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="Your time entries, settings, day notes and App Track usage are stored here."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="Changing the folder happens straight away, when you confirm it, not when you press Save, and Cancel does not undo it. Your data is copied to the new folder and checked; tick Move my data to delete the old copy afterwards. If the folder already has data (another PC's OneDrive folder, say) you can merge yours into it."/>
                    <TextBlock x:Name="CrashLogNote" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="UnavailableFolderText" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="#B45309" FontWeight="SemiBold" Visibility="Collapsed"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
