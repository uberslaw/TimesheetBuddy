<Window x:Class="TimesheetBuddy.Views.QuickAddJobCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add job code"
        Icon="/Assets/TimesheetBuddy.ico"
        Height="220" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Cancel" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Add" Width="80"
                    IsDefault="True" Click="Add_Click"/>
        </StackPanel>
        <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="New job code" Margin="0,0,0,12"/>
            <TextBlock Text="Code" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="CodeBox" Margin="0,0,0,10"/>
            <TextBlock Text="Description" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="DescriptionBox"/>
        </StackPanel>
    </DockPanel>
</Window>
