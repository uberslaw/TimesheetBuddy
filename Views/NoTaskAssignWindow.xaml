<Window x:Class="TimesheetBuddy.Views.NoTaskAssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="No Task Selected"
        Icon="/Assets/TimesheetBuddy.ico"
        Height="480" Width="1020"
        MinHeight="400" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CompactButton}" Content="Add row" Margin="0,0,8,0"
                        Click="AddRow_Click"/>
                <Button Style="{StaticResource CompactButton}" Content="All to Break" Margin="0,0,8,0"
                        ToolTip="Log all of this time as Break (no job code)"
                        Click="AllToBreak_Click"/>
                <Button Style="{StaticResource CompactButton}" Content="Not now" Width="90" Margin="0,0,8,0"
                        ToolTip="Keep it as No Task Selected and ask again at the next interval"
                        IsCancel="True" Click="NotNow_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Assign" Width="110"
                        IsDefault="True" Click="Assign_Click"/>
            </StackPanel>
            <TextBlock x:Name="MinutesHint" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="PromptTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SpansText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="Split it across one or more tasks. Anything you leave stays as No Task Selected (not counted in your totals) and is asked about again at the next interval."/>
        </StackPanel>

        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Common tasks:" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontWeight="SemiBold"/>
                    <ComboBox x:Name="CommonTasksCombo" Width="280" DisplayMemberPath="Name"/>
                    <Button Style="{StaticResource CompactButton}" Content="Insert into new row"
                            Margin="8,0,0,0" Click="InsertCommon_Click"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="RowsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource LineBrush}"
                      AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Task name"
                                        Binding="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="150"/>
                    <DataGridComboBoxColumn x:Name="CategoryCol" Header="Category"
                                            Width="110"
                                            SelectedItemBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridComboBoxColumn x:Name="CommonCol" Header="Common task"
                                            Width="140"
                                            DisplayMemberPath="Name"
                                            SelectedValuePath="Name"
                                            SelectedValueBinding="{Binding CommonTaskName, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Comment / what you did"
                                        Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>
                    <DataGridComboBoxColumn x:Name="CodeCol" Header="Job code"
                                            Width="160"
                                            DisplayMemberPath="Display"
                                            SelectedValuePath="Id"
                                            SelectedValueBinding="{Binding JobCodeId, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridComboBoxColumn x:Name="MinutesCol" Header="Minutes"
                                            Width="80"
                                            SelectedItemBinding="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Style="{StaticResource GhostButton}"
                                        Click="RemoveRow_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
