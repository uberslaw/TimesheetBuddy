<Window x:Class="TimesheetBuddy.Views.ChangeLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change log — Timesheet Buddy 3.0"
        Icon="/Assets/TimesheetBuddy.ico"
        Height="520" Width="720"
        MinHeight="300" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="RangeCombo" Width="120" SelectionChanged="Range_Changed"/>
                <CheckBox x:Name="ThisPcOnlyCheck" Content="This PC only" Margin="10,0,0,0"
                          VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <Button Style="{StaticResource CompactButton}" Content="Refresh" Margin="10,0,0,0"
                        Click="Refresh_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Change log"/>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource CompactButton}" Content="Close" Width="80"
                    IsCancel="True" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource CompactButton}" Content="Open folder"
                    Margin="0,0,8,0" Click="OpenFolder_Click"
                    ToolTip="Show the journal folder (one file per PC) in File Explorer"/>
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Each PC writes its own file in the data folder's journal folder. Changes older than 90 days are removed."/>
        </DockPanel>

        <Grid>
            <DataGrid x:Name="LinesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Extended"
                      BorderBrush="{StaticResource LineBrush}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding When}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PC" Binding="{Binding Machine}" Width="110"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="95"/>
                    <DataGridTextColumn Header="Details" Binding="{Binding Summary}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Text="No changes recorded in this period."
                       Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
