<Window x:Class="TimesheetBuddy.Views.LockPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen was locked"
        Icon="/Assets/TimesheetBuddy.ico"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,18"/>

        <!-- Last active task -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActiveLabel" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontWeight="SemiBold" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Assign"
                    MinWidth="88" Click="AssignActive_Click" IsDefault="True"/>
        </Grid>

        <!-- Assign to another job code -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Assign to" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CodeCombo" Grid.Column="1" DisplayMemberPath="Display"
                      VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="2" Style="{StaticResource CompactButton}" Content="Assign"
                    MinWidth="88" Click="AssignSelected_Click"/>
        </Grid>
    </StackPanel>
</Window>
