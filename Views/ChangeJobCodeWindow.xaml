<Window x:Class="TimesheetBuddy.Views.ChangeJobCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change job code"
        Icon="/Assets/TimesheetBuddy.ico"
        Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Cancel" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Change" Width="90"
                    IsDefault="True" Click="Change_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="TaskLabel" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="Job code" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CodeCombo" DisplayMemberPath="Display"/>
        </StackPanel>
    </DockPanel>
</Window>
