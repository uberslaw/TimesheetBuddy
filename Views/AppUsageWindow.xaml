<Window x:Class="TimesheetBuddy.Views.AppUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App usage — Timesheet Buddy 3.0"
        Icon="/Assets/TimesheetBuddy.ico"
        Height="460" Width="460"
        MinHeight="300" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PreviousDayButton" Style="{StaticResource CompactButton}" Content="◀"
                        ToolTip="Previous day" Click="PreviousDay_Click"/>
                <Button x:Name="TodayButton" Style="{StaticResource CompactButton}" Content="Today"
                        Margin="6,0,0,0" Click="Today_Click"/>
                <Button x:Name="NextDayButton" Style="{StaticResource CompactButton}" Content="▶"
                        Margin="6,0,0,0" ToolTip="Next day" Click="NextDay_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="App usage"/>
                <TextBlock x:Name="DayText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="OffHint" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" Visibility="Collapsed"
                   Text="App Track is off, so nothing new is being logged. Turn it on from Menu → App Track."/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource CompactButton}" Content="Close" Width="80"
                    IsCancel="True" Click="Close_Click"/>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                <Run Text="Total tracked:"/>
                <Run x:Name="TotalRun" FontFamily="Consolas"/>
            </TextBlock>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Only program names are recorded, never window titles, web pages, documents or email. Separate from your timesheet; not in totals or exports."/>

        <Grid>
            <DataGrid x:Name="AppsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      BorderBrush="{StaticResource LineBrush}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding Exe}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="%" Binding="{Binding PercentText}" Width="52">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Text="Nothing tracked on this day."
                       Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
