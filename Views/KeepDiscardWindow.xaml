<Window x:Class="TimesheetBuddy.Views.KeepDiscardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keep or discard — Timesheet Buddy 3.0"
        Icon="/Assets/TimesheetBuddy.ico"
        Width="560" Height="440" MinHeight="300" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="14">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock x:Name="AlreadyText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="QuestionText" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Would you like to keep any of this data or discard?"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource CompactButton}" Content="Discard all" Width="100" Margin="0,0,8,0"
                        Click="Discard_Click"/>
                <Button x:Name="KeepButton" Style="{StaticResource PrimaryButton}" Content="Keep selected" Width="120"
                        IsDefault="True" Click="Keep_Click"/>
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="ItemsList" Margin="0,10,0,0" BorderBrush="{StaticResource LineBrush}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontFamily="Consolas"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                        </CheckBox>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
