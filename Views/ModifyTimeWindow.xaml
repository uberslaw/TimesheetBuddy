<Window x:Class="TimesheetBuddy.Views.ModifyTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modify time"
        Icon="/Assets/TimesheetBuddy.ico"
        SizeToContent="Height" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Cancel" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="OK" Width="80"
                    IsDefault="True" Click="Ok_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="TaskLabel" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="CodeLabel" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock Margin="0,4,0,12" FontSize="11">
                <Run Text="Current total:" Foreground="{StaticResource MutedBrush}"/>
                <Run x:Name="TotalRun" FontFamily="Consolas, Cascadia Mono, Courier New" FontWeight="SemiBold"/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="AddRadio" Content="Add time" IsChecked="True" Margin="0,0,16,0"
                             GroupName="ModifyMode" Checked="Mode_Changed"/>
                <RadioButton x:Name="RemoveRadio" Content="Remove time"
                             GroupName="ModifyMode" Checked="Mode_Changed"/>
            </StackPanel>

            <TextBlock Text="Amount (hours : minutes)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource CompactButton}" Content="▼" Width="28" Padding="0,2"
                        Click="HoursDown_Click" ToolTip="Decrease hours"/>
                <TextBox x:Name="HoursBox" Width="40" Margin="6,0"
                         TextAlignment="Center" FontFamily="Consolas, Cascadia Mono"
                         FontSize="16" MaxLength="2"
                         LostFocus="TimeBox_LostFocus" PreviewTextInput="DigitsOnly_Preview"
                         DataObject.Pasting="DigitsOnly_Pasting"/>
                <Button Style="{StaticResource CompactButton}" Content="▲" Width="28" Padding="0,2"
                        Click="HoursUp_Click" ToolTip="Increase hours"/>

                <TextBlock Text=":" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0"/>

                <Button Style="{StaticResource CompactButton}" Content="▼" Width="28" Padding="0,2"
                        Click="MinutesDown_Click" ToolTip="Decrease minutes"/>
                <TextBox x:Name="MinutesBox" Width="40" Margin="6,0"
                         TextAlignment="Center" FontFamily="Consolas, Cascadia Mono"
                         FontSize="16" MaxLength="2"
                         LostFocus="TimeBox_LostFocus" PreviewTextInput="DigitsOnly_Preview"
                         DataObject.Pasting="DigitsOnly_Pasting"/>
                <Button Style="{StaticResource CompactButton}" Content="▲" Width="28" Padding="0,2"
                        Click="MinutesUp_Click" ToolTip="Increase minutes"/>
            </StackPanel>

            <TextBlock x:Name="RemoveHint" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</Window>
