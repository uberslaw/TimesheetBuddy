<Window x:Class="TimesheetBuddy.Views.FifteenMinuteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unaccounted time"
        Icon="/Assets/TimesheetBuddy.ico"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptTitle" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <!-- Last active / most recent task -->
        <Grid x:Name="ActiveRow" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActiveLabel" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontWeight="SemiBold" Margin="0,0,12,0"/>
            <Button x:Name="AssignActiveButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                    Content="Assign" MinWidth="88" Click="AssignActive_Click" IsDefault="True"/>
        </Grid>

        <!-- Today's logged tasks -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Assign to" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="TodayTasksCombo" Grid.Column="1" DisplayMemberPath="Display"
                      VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="AssignTodayButton" Grid.Column="2" Style="{StaticResource CompactButton}"
                    Content="Assign" MinWidth="88" Click="AssignToday_Click"/>
        </Grid>

        <!-- Enter a new task -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Or enter a new task" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Task name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
                        <TextBox x:Name="NewTaskBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Category" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="NewCategoryCombo" IsEditable="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Job code" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="NewCodeCombo" DisplayMemberPath="Display"/>
                    </StackPanel>
                    <Button Grid.Column="6" Style="{StaticResource CompactButton}" Content="Assign"
                            MinWidth="88" VerticalAlignment="Bottom" Click="AssignNew_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource CompactButton}" Content="Not now"
                    Width="90" IsCancel="True" Click="NotNow_Click"/>
            <TextBlock x:Name="MinutesHint" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        </DockPanel>
    </StackPanel>
</Window>
