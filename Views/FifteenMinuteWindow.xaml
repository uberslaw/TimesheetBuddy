<Window x:Class="TimesheetBuddy.Views.FifteenMinuteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unaccounted time"
        Height="520" Width="1020"
        MinHeight="440" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="MinutesHint" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CompactButton}" Content="Add row" Margin="0,0,8,0"
                        Click="AddRow_Click"/>
                <Button Style="{StaticResource CompactButton}" Content="Not now" Width="90" Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save &amp; continue" Width="140"
                        IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="PromptTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="0 unaccounted for minutes, would you like to assign tasks to them?"/>
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="Pick one or more tasks and assign minutes that add up to that time. You can give the whole gap to one task, or leave some unaccounted. Not now adds nothing."/>
        </StackPanel>

        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Common tasks:" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontWeight="SemiBold"/>
                    <ComboBox x:Name="CommonTasksCombo" Width="280" DisplayMemberPath="Name"/>
                    <Button Style="{StaticResource CompactButton}" Content="Insert into new row"
                            Margin="8,0,0,0" Click="InsertCommon_Click"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="RowsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource LineBrush}"
                      AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Task name"
                                        Binding="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="150"/>
                    <DataGridComboBoxColumn x:Name="CategoryCol" Header="Category"
                                            Width="110"
                                            SelectedItemBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridComboBoxColumn x:Name="CommonCol" Header="Common task"
                                            Width="140"
                                            DisplayMemberPath="Name"
                                            SelectedValuePath="Name"
                                            SelectedValueBinding="{Binding CommonTaskName, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Comment / what you did"
                                        Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>
                    <DataGridComboBoxColumn x:Name="CodeCol" Header="Job code"
                                            Width="160"
                                            DisplayMemberPath="Display"
                                            SelectedValuePath="Id"
                                            SelectedValueBinding="{Binding JobCodeId, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridComboBoxColumn x:Name="MinutesCol" Header="Minutes"
                                            Width="80"
                                            SelectedItemBinding="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Style="{StaticResource GhostButton}"
                                        Click="RemoveRow_Click" Tag="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
