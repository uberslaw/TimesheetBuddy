<Window x:Class="TimesheetBuddy.Views.DayLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Today's timesheet — Timesheet Buddy 3.0"
        Height="520" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Day log"/>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource CompactButton}"
                    Content="Add manual entry" HorizontalAlignment="Right"
                    Click="AddManual_Click"/>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Put in notes for the day" Margin="0,0,0,6"/>
                <TextBox x:Name="DayNotesBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         LostFocus="DayNotesBox_LostFocus"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="EntriesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource LineBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Start" Binding="{Binding StartLocal}" Width="70"/>
                <DataGridTextColumn Header="End" Binding="{Binding EndLocal}" Width="70"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                <DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="*"/>
                <DataGridTextColumn Header="Job code" Binding="{Binding Code}" Width="160"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="160"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
