<Window x:Class="TimesheetBuddy.Views.RecheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Still working?"
        Height="260" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Switch task…" Width="110" Margin="0,0,8,0"
                    Click="Switch_Click"/>
            <Button Style="{StaticResource CompactButton}" Content="Stop timer" Width="100" Margin="0,0,8,0"
                    Click="Stop_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Yes, still on it" Width="130"
                    IsDefault="True" Click="StillWorking_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Are you still working on this task?"/>
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="TaskLabel" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CodeLabel" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ElapsedLabel" FontFamily="Consolas, Cascadia Mono"
                               Foreground="{StaticResource TimerBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Check again in:" Margin="0,16,0,6" Foreground="{StaticResource MutedBrush}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="HoursCombo" Width="80"/>
                <TextBlock Text="hours" VerticalAlignment="Center" Margin="8,0,16,0"/>
                <ComboBox x:Name="MinutesCombo" Width="80"/>
                <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
