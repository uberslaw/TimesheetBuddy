<Window x:Class="TimesheetBuddy.Views.ImportDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import data — Timesheet Buddy 3.0"
        Icon="/Assets/TimesheetBuddy.ico"
        Width="620" Height="560" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Bring time entries, job codes, day notes and App Track usage in from an older copy: a backup, a OneDrive conflict copy, another data folder, or the data of an earlier Timesheet Buddy release. Nothing you have now is removed or overwritten; your settings.json is backed up first."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Close" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="Close_Click"/>
            <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Content="Import" Width="100"
                    IsEnabled="False" Click="Import_Click"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource PanelBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,10,0,0" MinHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap"
                           Text="Pick a copy above, or choose a folder or a settings file."/>
            </ScrollViewer>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Choose folder…" Padding="12,3"
                    ToolTip="An older data folder, e.g. %LocalAppData%\TimesheetBuddy from another PC or a OneDrive folder"
                    Click="ChooseFolder_Click"/>
            <Button Style="{StaticResource CompactButton}" Content="Choose file…" Padding="12,3" Margin="8,0,0,0"
                    ToolTip="A settings.json, a settings.json.bak-… backup or a OneDrive conflict copy"
                    Click="ChooseFile_Click"/>
        </StackPanel>

        <ListBox x:Name="CandidatesList" SelectionChanged="CandidatesList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
