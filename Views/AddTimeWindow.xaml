<Window x:Class="TimesheetBuddy.Views.AddTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add time"
        Icon="/Assets/TimesheetBuddy.ico"
        Height="190" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Cancel" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Add" Width="80"
                    IsDefault="True" Click="Add_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="TaskLabel" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="Duration (HH:MM)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Hours: down left, up right -->
                <Button Style="{StaticResource CompactButton}" Content="▼" Width="28" Padding="0,2"
                        Click="HoursDown_Click" ToolTip="Decrease hours"/>
                <TextBox x:Name="HoursBox" Width="40" Margin="6,0"
                         TextAlignment="Center" FontFamily="Consolas, Cascadia Mono"
                         FontSize="16" MaxLength="2"
                         LostFocus="TimeBox_LostFocus" PreviewTextInput="DigitsOnly_Preview"
                         DataObject.Pasting="DigitsOnly_Pasting"/>
                <Button Style="{StaticResource CompactButton}" Content="▲" Width="28" Padding="0,2"
                        Click="HoursUp_Click" ToolTip="Increase hours"/>

                <TextBlock Text=":" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0"/>

                <!-- Minutes: down left, up right -->
                <Button Style="{StaticResource CompactButton}" Content="▼" Width="28" Padding="0,2"
                        Click="MinutesDown_Click" ToolTip="Decrease minutes"/>
                <TextBox x:Name="MinutesBox" Width="40" Margin="6,0"
                         TextAlignment="Center" FontFamily="Consolas, Cascadia Mono"
                         FontSize="16" MaxLength="2"
                         LostFocus="TimeBox_LostFocus" PreviewTextInput="DigitsOnly_Preview"
                         DataObject.Pasting="DigitsOnly_Pasting"/>
                <Button Style="{StaticResource CompactButton}" Content="▲" Width="28" Padding="0,2"
                        Click="MinutesUp_Click" ToolTip="Increase minutes"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
