<Window x:Class="TimesheetBuddy.Views.RestoreDeletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore deleted tasks"
        Icon="/Assets/TimesheetBuddy.ico"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Task types deleted today can be restored. Yesterday’s deletions are removed automatically."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Select all" Margin="0,0,8,0"
                    Click="SelectAll_Click"/>
            <Button Style="{StaticResource CompactButton}" Content="Restore selected" Margin="0,0,8,0"
                    Click="RestoreSelected_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Restore all" Margin="0,0,8,0"
                    Click="RestoreAll_Click"/>
            <Button Style="{StaticResource CompactButton}" Content="Close" Width="80"
                    IsCancel="True" Click="Close_Click"/>
        </StackPanel>

        <DataGrid x:Name="DeletedGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource LineBrush}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                <DataGridTextColumn Header="Task" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Deleted at" Binding="{Binding DeletedAtDisplay}" Width="90" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
