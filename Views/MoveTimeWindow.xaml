<Window x:Class="TimesheetBuddy.Views.MoveTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move time"
        Icon="/Assets/TimesheetBuddy.ico"
        Height="420" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TaskLabel" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SourceLabel" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,2,0,10"/>
            <TextBlock Text="Move to job code" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="FilterBox" Margin="0,0,0,6" TextChanged="FilterBox_TextChanged"
                     PreviewKeyDown="FilterBox_PreviewKeyDown"
                     ToolTip="Type to filter the job codes"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Cancel" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Move…" Width="80"
                    IsDefault="True" Click="Move_Click"/>
        </StackPanel>

        <Grid>
            <ListBox x:Name="TargetList" DisplayMemberPath="Display"
                     MouseDoubleClick="TargetList_MouseDoubleClick"/>
            <TextBlock x:Name="EmptyText" Text="No job codes match" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"
                       Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
