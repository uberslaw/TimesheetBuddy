<Window x:Class="TimesheetBuddy.Views.MoveTimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move time"
        Icon="/Assets/TimesheetBuddy.ico"
        Height="420" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TaskLabel" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SourceLabel" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,2,0,10"/>
            <TextBlock x:Name="TargetHeader" Text="Move to job code" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="FilterBox" Margin="0,0,0,6" TextChanged="FilterBox_TextChanged"
                     PreviewKeyDown="FilterBox_PreviewKeyDown"
                     ToolTip="Type to filter the job codes"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Cancel" Width="80" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Move…" Width="80"
                    IsDefault="True" Click="Move_Click"/>
        </StackPanel>

        <Grid x:Name="NewTaskPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Task name" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
            <TextBlock Grid.Column="2" Text="Category" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
            <TextBox x:Name="NewTaskNameBox" Grid.Row="1" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="NewCategoryBox" Grid.Row="1" Grid.Column="2" IsEditable="True"/>
        </Grid>

        <Grid>
            <ListBox x:Name="TargetList" DisplayMemberPath="Display"
                     SelectionChanged="TargetList_SelectionChanged"
                     MouseDoubleClick="TargetList_MouseDoubleClick"/>
            <TextBlock x:Name="EmptyText" Text="No job codes match" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"
                       Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
