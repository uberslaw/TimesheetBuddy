<Window x:Class="TimesheetBuddy.Views.AddJobCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add job code"
        Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>

        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Add a row"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,12"
                       Text="Pick a job code that already exists, or create a new code and description."/>

            <TextBlock Text="Existing job code" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
            <ComboBox x:Name="CodeCombo" DisplayMemberPath="Display" Margin="0,0,0,8"/>
            <Button x:Name="AddExistingButton" Style="{StaticResource CompactButton}" Content="Add existing"
                    HorizontalAlignment="Left" Click="AddExisting_Click" Margin="0,0,0,16"/>

            <TextBlock Text="Or create a new code" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Code" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="CodeBox" Margin="0,0,0,8"/>
            <TextBlock Text="Description" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="DescriptionBox" Margin="0,0,0,8"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Create and add"
                    HorizontalAlignment="Left" Click="Create_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
