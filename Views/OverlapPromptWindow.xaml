<Window x:Class="TimesheetBuddy.Views.OverlapPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timesheet Buddy"
        Icon="/Assets/TimesheetBuddy.ico"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="True"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Yes keeps this PC and closes the other one (you can keep its entries). Not now leaves both open; saves still merge."/>
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Not now" Width="80" Margin="0,0,8,0"
                    Click="NotNow_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Yes" Width="80" Click="Yes_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
