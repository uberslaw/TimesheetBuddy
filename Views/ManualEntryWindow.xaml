<Window x:Class="TimesheetBuddy.Views.ManualEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add manual entry"
        Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource CompactButton}" Content="Cancel" Width="90" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Add" Width="90"
                    IsDefault="True" Click="Add_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Task name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="TaskBox" Margin="0,0,0,10"/>

            <TextBlock Text="Job code" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
            <ComboBox x:Name="CodeCombo" DisplayMemberPath="Display" Margin="0,0,0,10"/>

            <TextBlock Text="Category" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
            <ComboBox x:Name="CategoryCombo" IsEditable="True" Margin="0,0,0,10"/>

            <TextBlock Text="Time" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="HoursBox" Width="56" MaxLength="6" Text="0" TextAlignment="Right"
                         ToolTip="Hours (0 or more)"/>
                <TextBlock Text="hours" VerticalAlignment="Center" Margin="6,0,14,0"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="MinutesBox" Width="56" MaxLength="2" Text="15" TextAlignment="Right"
                         ToolTip="Minutes (0–59)"/>
                <TextBlock Text="minutes" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>

            <TextBlock Text="Comments" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
            <TextBox x:Name="CommentsBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </DockPanel>
</Window>
